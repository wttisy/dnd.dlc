    <details id="giveaways" style="background: rgba(0, 0, 0, 0.03); border: 1px solid rgba(0, 0, 0, 0.1); border-radius: 6px; margin-bottom: 10px; overflow: hidden;">
        <summary style="padding: 14px 18px; font-size: 18px; font-weight: 800; color: #1e293b; text-transform: uppercase; cursor: pointer;">
