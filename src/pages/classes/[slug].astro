---
// 1. Указываем все возможные классы и их данные
export function getStaticPaths() {
  const classes = [
    // Воины
    { id: 'zhnec', title: 'Жнец', type: 'Воин', back: '/multiclasses', desc: 'Жнецов обычно представляют как злых собирателей душ, однако на самом деле это не так.' },
    { id: 'speedster', title: 'Спидстер', type: 'Воин', back: '/multiclasses', desc: 'Молниеносный боец, превосходящий врагов в скорости.' },
    { id: 'assassin', title: 'Ассасин', type: 'Воин', back: '/multiclasses', desc: 'Ассасины не всегда являются тёмными путниками, но всё же умения говорят об обратном.' },
    { id: 'knight', title: 'Рыцарь', type: 'Воин', back: '/multiclasses', desc: 'Закованный в тяжелую броню защитник веры и чести.' },
    { id: 'oplot', title: 'Оплот', type: 'Воин', back: '/multiclasses', desc: 'Несокрушимая стена обороны отряда.' },
    { id: 'jeger', title: 'Егерь', type: 'Воин', back: '/multiclasses', desc: 'Мастер выживания, дальнего боя и ловушек.' },
    { id: 'paladin', title: 'Паладин', type: 'Воин', back: '/multiclasses', desc: 'Святой воитель, карающий врагов светом и мечом.' },

    // Маги
    { id: 'wizard', title: 'Волшебник', type: 'Маг', back: '/multiclasses', desc: 'Интеллектуальный заклинатель, изучающий тайные книги.' },
    { id: 'druid', title: 'Друид', type: 'Маг', back: '/multiclasses', desc: 'Хранитель природы, меняющий форму и повелитель стихий.' },
    { id: 'weaver', title: 'Ткач', type: 'Маг', back: '/multiclasses', desc: 'Мастер плетения магических нитей и пространственных аномалий.' },
    { id: 'medium', title: 'Медиум', type: 'Маг', back: '/multiclasses', desc: 'Проводник между миром живых и духами.' },
    { id: 'prisma', title: 'Призма', type: 'Маг', back: '/multiclasses', desc: 'Призма - укратитель магии, способный менять форму и вид стандартных заклинаний. Его мощь поражает, однако он не способен унаследовать чистое изменение.' },

    // Эксперты
    { id: 'alchemist', title: 'Алхимик', type: 'Эксперт', back: '/multiclasses', desc: 'Создатель взрывных зелий, ядов и эликсиров.' },
    { id: 'engineer', title: 'Инженер', type: 'Эксперт', back: '/multiclasses', desc: 'Создатель механизмов, турелей и сложных устройств.' },
    { id: 'bard', title: 'Бард', type: 'Эксперт', back: '/multiclasses', desc: 'Бард - настоящее воплощение живой музыки, амбиций и характера' },
  ];

  return classes.map(item => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
---

<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<title>{item.title} — Twilight Sparkles</title>
		<style>
			.content-card {
				background: #ece4d9; 
				border: 1px solid #e2e8f0;
				border-radius: 20px;
				padding: 40px;
				color: #000000 !important;
				max-width: 1300px;
				width: 100%;
				box-sizing: border-box;
				box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
                position: relative; 
                overflow: hidden;
			}
            .content-card h1,
            .content-card h2,
            .content-card h3,
            .content-card h4,
            .content-card p,
            .content-card span,
            .content-card div,
            .content-card li {
                color: #1e293b !important;
            }
            .content-card table {
                color: #1e293b !important;
            }
            .content-card th {
                color: #0f172a !important;
            }
			.ability-block { border-bottom: 1px solid rgba(0, 0, 0, 0.15); padding-bottom: 10px; margin-bottom: 18px; }
            .ability-title { font-size: 20px; font-weight: 800; color: #1e293b; text-transform: uppercase; margin: 0 0 4px 0; }
            .ability-subtitle { font-size: 13px; font-style: italic; color: #475569; margin: 0 0 8px 0; }
            .ability-text { font-size: 15px; line-height: 1.5; color: #1e293b; margin-top: 0; margin-bottom: 8px; }
            .ability-text ul {margin: 6px 0 10px 20px; padding: 0; }
            .ability-text li { margin-bottom: 4px; color: #1e293b; }
		</style>
	</head>
	<body style="font-family: sans-serif; margin: 0; min-height: 100vh; background-image: linear-gradient(rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.3)), url('/bg.jpg'); background-repeat: no-repeat; background-position: center; background-size: cover; background-attachment: fixed; display: flex; flex-direction: column; align-items: center; padding: 60px 20px;">
		
		<a href={item.back} style="position: absolute; left: 40px; top: 40px; color: #ffffff; text-decoration: none; font-weight: 600;">← Назад к списку</a>

		<div class="content-card">
			<h1 style="font-size: 34px; margin-top: 0; margin-bottom: 10px;">{item.title}</h1>
			<p style="font-size: 14px; color: #000000; font-style: italic; margin-bottom: 25px;">Тип: {item.type}</p>
            
            <!-- Базовое описание из массива -->
            <div class="ability-block">
				<h3 class="ability-title">Общая информация</h3>
				<p class="ability-subtitle">Роль в отряде</p>
				<p class="ability-text">{item.desc}</p>
			</div>

            {item.id === 'zhnec' && (
                <div>
                    <!-- 1. СНАЧАЛА ТАБЛИЦА -->
                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 25px; color: #e2e8f0; font-size: 15px;">
                        <thead>
                            <tr style="border-bottom: 2px solid rgba(230, 226, 226, 0.5);">
                                <th style="text-align: left; padding: 10px; color: #ffffff;">Уровень</th>
                                <th style="text-align: left; padding: 10px; color: #ffffff;">Бонус Мастерства</th>
                                <th style="text-align: left; padding: 10px; color: #ffffff;">Умения</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
                                <td style="padding: 10px;">1</td>
                                <td style="padding: 10px;">+2</td>
                                <td style="padding: 10px;">Пожинание, Использование Добычи</td>
                            </tr>
                            <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
                                <td style="padding: 10px;">2</td>
                                <td style="padding: 10px;">+2</td>
                                <td style="padding: 10px;">Жестокий приём</td>
                            </tr>
                             <tr style="border-bottom: 1px solid rgba(253, 253, 253, 0.1);">
                                <td style="padding: 10px;">3</td>
                                <td style="padding: 10px;">+2</td>
                                <td style="padding: 10px;">Углублёная охота</td>
                            </tr>
                            <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
                                <td style="padding: 10px;">4</td>
                                <td style="padding: 10px;">+2</td>
                                <td style="padding: 10px;">Увеличение характеристик</td>
                            </tr>
                            <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
                                <td style="padding: 10px;">5</td>
                                <td style="padding: 10px;">+3</td>
                                <td style="padding: 10px;">Дополнительная атака, Жестокий приём(1к8)</td>
                            </tr>
                            <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
                                <td style="padding: 10px;">6</td>
                                <td style="padding: 10px;">+3</td>
                                <td style="padding: 10px;">Пожинание гигантов, Величественный трофей</td>
                            </tr>
                               <tr style="border-bottom: 1px solid rgba(255, 254, 254, 0.1);">
                                <td style="padding: 10px;">7</td>
                                <td style="padding: 10px;">+3</td>
                                <td style="padding: 10px;">Особенности Углублёной Охоты</td>
                            </tr>
                            <tr style="border-bottom: 1px solid rgba(255, 254, 254, 0.1);">
                                <td style="padding: 10px;">8</td>
                                <td style="padding: 10px;">+3</td>
                                <td style="padding: 10px;">Увеличение характеристик</td>
                            </tr>
                            <tr style="border-bottom: 1px solid rgba(255, 254, 254, 0.1);">
                                <td style="padding: 10px;">9</td>
                                <td style="padding: 10px;">+4</td>
                                <td style="padding: 10px;">Разбор</td>
                            </tr>
                            <tr style="border-bottom: 1px solid rgba(255, 254, 254, 0.1);">
                                <td style="padding: 10px;">10</td>
                                <td style="padding: 10px;">+4</td>
                                <td style="padding: 10px;">Разнообразная добыча</td>
                            </tr>
                            <tr style="border-bottom: 1px solid rgba(255, 254, 254, 0.1);">
                                <td style="padding: 10px;">11</td>
                                <td style="padding: 10px;">+4</td>
                                <td style="padding: 10px;">Особенности Углублёной Охоты</td>
                            </tr>
                            <tr style="border-bottom: 1px solid rgba(255, 254, 254, 0.1);">
                                <td style="padding: 10px;">12</td>
                                <td style="padding: 10px;">+4</td>
                                <td style="padding: 10px;">Увеличение характеристик</td>
                            </tr>
                            <tr style="border-bottom: 1px solid rgba(255, 254, 254, 0.1);">
                                <td style="padding: 10px;">13</td>
                                <td style="padding: 10px;">+5</td>
                                <td style="padding: 10px;">Жестокий удар(1к10)</td>
                            </tr>
                            <tr style="border-bottom: 1px solid rgba(255, 254, 254, 0.1);">
                                <td style="padding: 10px;">14</td>
                                <td style="padding: 10px;">+5</td>
                                <td style="padding: 10px;">Последний трофей</td>
                            </tr>
                            <tr style="border-bottom: 1px solid rgba(255, 254, 254, 0.1);">
                                <td style="padding: 10px;">15</td>
                                <td style="padding: 10px;">+5</td>
                                <td style="padding: 10px;">Особенности Углублёной Охоты, Жестокий приём(1к12)</td>
                            </tr>
                            <tr style="border-bottom: 1px solid rgba(255, 254, 254, 0.1);">
                                <td style="padding: 10px;">16</td>
                                <td style="padding: 10px;">+5</td>
                                <td style="padding: 10px;">Увеличение характеристик</td>
                            </tr>
                            <tr style="border-bottom: 1px solid rgba(255, 254, 254, 0.1);">
                                <td style="padding: 10px;">17</td>
                                <td style="padding: 10px;">+6</td>
                                <td style="padding: 10px;">Великая жатва</td>
                            </tr>
                            <tr style="border-bottom: 1px solid rgba(255, 254, 254, 0.1);">
                                <td style="padding: 10px;">18</td>
                                <td style="padding: 10px;">+6</td>
                                <td style="padding: 10px;">Совершенный жнец</td>
                            </tr>
                            <tr style="border-bottom: 1px solid rgba(255, 254, 254, 0.1);">
                                <td style="padding: 10px;">19</td>
                                <td style="padding: 10px;">+6</td>
                                <td style="padding: 10px;">Увеличение характеристик</td>
                            </tr>
                            <tr style="border-bottom: 1px solid rgba(255, 254, 254, 0.1);">
                                <td style="padding: 10px;">20</td>
                                <td style="padding: 10px;">+6</td>
                                <td style="padding: 10px;">Кровожатва</td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- 2. ПОТОМ БЛОК СПОСОБНОСТИ -->
                    <div class="ability-block">
                        <h3 class="ability-title">Пожинание</h3>
                        <p class="ability-subtitle">1-й уровень, умение жнеца</p>
                        <p class="ability-text">Вы научились извлекать пользу из побеждённых врагов.</p>
                        <p class="ability-text">Теперь за каждое убийство врага вы получаете Добычу. Максимум предела Добычи равняется мод. Мудрости + бонус мастерства. Добыча используется бонусным действием. Вы сами выбираете, собрать ли Добычу с существа или нет.</p>
                        <p class="ability-text">Вы сами выбираете как выглядит ваша Добыча, однако она обязательно должна быть материальной. Вы так же можете передавать добычу своим сюзникам. Бонусным действием вы можете бросить Добычу союзнику, чтобы он её использовал. </p>
                    </div>
                    <div class="ability-block">
                        <h3 class="ability-title">Использование Добычи</h3>
                        <p class="ability-subtitle">1-й уровень, умение жнеца</p>
                        <p class="ability-text">Настоящие жнецы умеют отделять пользу разной Добычи. Добыча делится на несколько типов:</p>
                        <ul class="ability-text">
                        <li>Нежить</li>
                        <li>Гуманоиды</li>
                        <li>Звери</li>
                        <li>Конструкты</li>
                        <li>Монстры</li>
                        <li>Небожители</li>
                        <li>Элементали</li>
                        <li>Растения</li>
                        <li>Феи</li>
                        </ul>
                        <a href="#loot-effects" style="display: inline-block; margin-top: 4px; color: #2563eb; text-decoration: underline; font-size: 15px;">Подробнее см. ниже</a>
                    </div>
                    <div class="ability-block">
                        <h3 class="ability-title">Жестокий удар</h3>
                        <p class="ability-subtitle">2-й уровень, умение жнеца</p>
                        <p class="ability-text">Удары по врагам проявляются с особой жестокостью. Попадая по врагу, вы наносите дополнительные 1к6 некротического урона при условии что хиты цели не равны максимуму.</p>
                        <p class="ability-text">Урон увеличивается до 1к8 на 5-м уровне, 1к10 на 11-м и 1к12 на 15 уровне.</p>
                    </div>
                    <div class="ability-block">
                        <h3 class="ability-title">Боевой стиль</h3>
                        <p class="ability-subtitle">2-й уровень, умение жнеца</p>
                        <p class="ability-text">Вы выбираете боевой стиль, соответствующий вашей специализации. Выберите один из следующих вариантов. Вы не можете выбирать один и тот же вариант боевого стиля, даже если позже у вас будет возможность выбрать еще один стиль.</p>
                        <p class="ability-text"><strong>Дуэлянт</strong></p>
                        <p class="ability-text">Пока вы держите рукопашное оружие в одной руке и не используете другого оружия, вы получаете бонус +2 к броскам урона этим оружием.</p>
                        <p class="ability-text"><strong>Оборона</strong></p>
                        <p class="ability-text">Если существо, которое вы видите, атакует не вас, а другое существо, находящееся в пределах 5 футов от вас, вы можете реакцией создать помеху его броску атаки. Для этого вы должны использовать щит.</p>
                        <p class="ability-text"><strong>Защита</strong></p>
                        <p class="ability-text">Пока вы носите доспехи, вы получаете бонус +1 к КД.</p>
                        <p class="ability-text"><strong>Сражение большим оружием</strong></p>
                        <p class="ability-text">Если у вас выпало «1» или «2» на кости урона при атаке, которую вы совершали рукопашным оружием, удерживая его двумя руками, то вы можете перебросить эту кость, и должны использовать новый результат, даже если снова выпало «1» или «2». Чтобы воспользоваться этим преимуществом, ваше оружие должно иметь свойство «двуручное» или «универсальное».</p>
                        <p class="ability-text"><strong>Сражение двумя оружиями</strong></p>
                        <p class="ability-text">Если вы сражаетесь двумя оружиями, вы можете добавить модификатор характеристики к урону от второй атаки.</p>
                        <p class="ability-text"><strong>Стрельба</strong></p>
                        <p class="ability-text">Вы получаете бонус +2 к броску атаки, когда атакуете дальнобойным оружием.</p>
                    </div>
                    <div class="ability-block">
                        <h3 class="ability-title">Углублёная охота</h3>
                        <p class="ability-subtitle">3-й уровень, умение жнеца</p>
                        <p class="ability-text">Вы выбираете собственный стиль добычи. Добыча даст вам умения на 3-м, 7-м, 13-м и 15-м уровнях.</p>
                    </div>
                    <div class="ability-block">
                        <h3 class="ability-title">Увеличение характеристик</h3>
                        <p class="ability-subtitle">4-й уровень, умение жнеца</p>
                        <p class="ability-text">При достижении 4-го, потом 6-го, 8-го, 12-го, 14-го, 16-го и 19-го уровней вы можете повысить значение одной из ваших характеристик на 2 или двух характеристик на 1. Как обычно, значение характеристики при этом не должно превысить 20.</p>
                        <p class="ability-text">Если ваш Мастер разрешает использование черт, вы можете отказаться от преимуществ этого умения при повышении значений характеристик и вместо этого взять черту.</p>
                    </div>
                    <div class="ability-block">
                        <h3 class="ability-title">Дополнительная атака</h3>
                        <p class="ability-subtitle">5-й уровень, умение жнеца</p>
                        <p class="ability-text">Если вы в свой ход совершаете действие Атака, вы можете совершить две атаки вместо одной.</p>
                    </div>
                    <div class="ability-block">
                        <h3 class="ability-title">Пожинание гигантов</h3>
                        <p class="ability-subtitle">6-й уровень, умение жнеца</p>
                        <p class="ability-text">Вы способны собирать добычу с крупных целей. Теперь, любая добыча, собранная с существ размера Большой или больше, будет давать 2 добычи вместо 1, игнорируя при этом максимальный запас</p>
                    </div>
                    <div class="ability-block">
                        <h3 class="ability-title">Величественный трофей</h3>
                        <p class="ability-subtitle">6-й уровень, умение жнеца</p>
                        <p class="ability-text">Получение Добычи с более редких существ теперь не представляет труда. Теперь вы можете получать добычу с:</p>
                        <ul class="ability-text">
                        <li>Великаны</li>
                        <li>Драконы</li>
                        <li>Обьекты</li>
                        <li>Абберации</li>
                        <li>Исчадия</li>
                        </ul>
                    </div>
                    <div class="ability-block">
                        <h3 class="ability-title">Разбор</h3>
                        <p class="ability-subtitle">9-й уровень, умения жнеца</p>
                        <p class="ability-text">Ваше умение собирать Добычу возрасло в разы. Теперь, когда вы побеждаете существо, помимо добычи вы так же можете получить его Душу. Эффект Души зависит от природы существа, например:</p>
                        <ul class="ability-text">
                        <li>Вы победили Взрослого Красного Дракона. Его душа даёт вам сопротивление к огню до конца продолжительного отдыха</li>
                        <p class="ability-text">Или:</p>
                        <li>Вы победили тёмного Лича. Его душа даёт вам 30 временных хитов и усиление атак для типа некротического урона</li>
                        </ul>
                    </div>
                     <div class="ability-block">
                        <h3 class="ability-title">Разнообразная добыча</h3>
                        <p class="ability-subtitle">10-й уровень, умение жнеца</p>
                        <p class="ability-text">Обычная Добыча - больше не ваш уровень. Вы способны комбинировать Добычу и получать от этого сразу несколько бонусов.</p>
                        <a href="#loot-effects" style="display: inline-block; margin-top: 4px; color: #2563eb; text-decoration: underline; font-size: 15px;">Подробнее см. ниже</a>
                    </div>
                    <div class="ability-block">
                        <h3 class="ability-title">Последний трофей</h3>
                        <p class="ability-subtitle">14-й уровень, умение жнеца</p>
                        <p class="ability-text">Сбор добычи ещё не закончен. Когда вы опускаетесь до 0 хитов, вы можете потратить 3 Добычи чтобы остаться на 1 хите. После этого, вы сможете сразу переместиться на половину своей скорости либо совершить рукопашную атаку. Вы можете использовать это умение снова после продолжительного отдыха.</p>
                    </div>
                    <div class="ability-block">
                        <h3 class="ability-title">Великая жатва</h3>
                        <p class="ability-subtitle">17-й уровень, умение жнеца</p>
                        <p class="ability-text">Ваш голод добычи никогда не угасает. Теперь, любое убийство что будет давать Добычу когда хранилище заполнено, Добычу можно конвертировать в ресурс, данный подклассом. Максимальное количество конвертаций равняется 5.</p>
                    </div>
                    <div class="ability-block">
                        <h3 class="ability-title">Совершенный жнец</h3>
                        <p class="ability-subtitle">18-й уровень, умение жнеца</p>
                        <p class="ability-text">Эффекты от Добычи кажутся вам слишком ничтожными. При использовании Добычи его эффект удваивается, однако это не распространяется на эффект Добычи от подкласса.</p>
