---
// Страница со всеми классами, разбитыми по категориям
---

<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<title>Классы — Twilight Sparkles</title>
		<style>
			* { box-sizing: border-box; }
			body {
				font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
				margin: 0;
				min-height: 100vh;
				background-color: #121212;
				background-image: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)), url('/bg.png');
				background-size: cover;
				background-attachment: fixed;
				background-position: center;
				color: #e2e8f0;
				display: flex;
			}

			/* ЛЕВАЯ ПАНЕЛЬ НАВИГАЦИИ */
			aside {
				width: 260px;
				background-color: rgba(24, 24, 27, 0.95);
				backdrop-filter: blur(10px);
				border-right: 1px solid rgba(255, 255, 255, 0.1);
				padding: 20px 15px;
				height: 100vh;
				position: fixed;
				left: 0;
				top: 0;
				overflow-y: auto;
				z-index: 10;
			}

			.logo {
				font-size: 18px;
				font-weight: 800;
				color: #ffffff;
				margin-bottom: 25px;
				padding-left: 10px;
				letter-spacing: 0.5px;
				text-decoration: none;
				display: block;
			}

			.nav-section-title {
				font-size: 13px;
				text-transform: uppercase;
				color: #f59e0b;
				font-weight: 700;
				margin: 20px 0 8px 10px;
				letter-spacing: 1px;
			}

			.nav-links {
				list-style: none;
				padding: 0;
				margin: 0 0 15px 0;
			}

			.nav-links li a {
				display: block;
				padding: 8px 10px;
				color: #cbd5e1;
				text-decoration: none;
				font-size: 14px;
				border-radius: 6px;
				transition: all 0.2s ease;
			}

			.nav-links li a:hover {
				background-color: rgba(255, 255, 255, 0.08);
				color: #ffffff;
				transform: translateX(3px);
			}

			/* ОСНОВНОЙ КОНТЕНТ */
			main {
				margin-left: 260px;
				flex: 1;
				padding: 40px;
				max-width: 1200px;
			}

			h1.page-title {
				font-size: 28px;
				color: #ffffff;
				margin-top: 0;
				margin-bottom: 25px;
				font-weight: 700;
			}

			.category-card {
				background: rgba(30, 30, 35, 0.85);
				backdrop-filter: blur(8px);
				border: 1px solid rgba(255, 255, 255, 0.1);
				border-radius: 12px;
				padding: 25px;
				margin-bottom: 25px;
				box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
			}

			.category-title {
				font-size: 20px;
				font-weight: 700;
				color: #ffffff;
				margin-top: 0;
				margin-bottom: 15px;
				border-bottom: 1px solid rgba(255, 255, 255, 0.1);
				padding-bottom: 10px;
			}

			.classes-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
				gap: 15px;
			}

			.class-link-btn {
				background: rgba(255, 255, 255, 0.06);
				border: 1px solid rgba(255, 255, 255, 0.1);
				border-radius: 8px;
				padding: 15px;
				color: #ffffff;
				text-decoration: none;
				font-weight: 600;
				text-align: center;
				transition: all 0.2s ease;
				display: block;
			}

			.class-link-btn:hover {
				background: rgba(255, 255, 255, 0.15);
				border-color: rgba(255, 255, 255, 0.3);
				transform: translateY(-2px);
			}
		</style>
	</head>
	<body>

		<!-- ЛЕВАЯ ПАНЕЛЬ НАВИГАЦИИ -->
		<aside>
			<a href="/" class="logo">Twilight Sparkles</a>

			<div class="nav-section-title">Справочники</div>
			<ul class="nav-links">
				<li><a href="/multiclasses">Классы</a></li>
				<li><a href="/backgrounds">Предыстории</a></li>
				<li><a href="/feats">Черты</a></li>
				<li><a href="/spells">Заклинания</a></li>
				<li><a href="/bestiary">Бестиарий</a></li>
			</ul>

			<div class="nav-section-title">Статьи</div>
			<ul class="nav-links">
				<li><a href="/inventory">Инвентарь</a></li>
				<li><a href="/mechanics">Игровые механики</a></li>
				<li><a href="/lore">Лор</a></li>
			</ul>
		</aside>

		<!-- ПРАВАЯ ЧАСТЬ С КЛАССАМИ -->
		<main>
			<h1 class="page-title">Справочник: Классы</h1>

			<!-- Категория: Воины -->
			<div class="category-card">
				<h2 class="category-title">Воины</h2>
				<div class="classes-grid">
					<a href="/classes/zhnec" class="class-link-btn">Жнец</a>
					<a href="/classes/speedster" class="class-link-btn">Спидстер</a>
					<a href="/classes/assassin" class="class-link-btn">Ассасин</a>
					<a href="/classes/knight" class="class-link-btn">Рыцарь</a>
					<a href="/classes/oplot" class="class-link-btn">Оплот</a>
					<a href="/classes/jeger" class="class-link-btn">Егерь</a>
					<a href="/classes/paladin" class="class-link-btn">Паладин</a>
				</div>
			</div>

			<!-- Категория: Маги -->
			<div class="category-card">
				<h2 class="category-title">Маги</h2>
				<div class="classes-grid">
					<a href="/classes/wizard" class="class-link-btn">Волшебник</a>
					<a href="/classes/druid" class="class-link-btn">Друид</a>
					<a href="/classes/weaver" class="class-link-btn">Ткач</a>
					<a href="/classes/medium" class="class-link-btn">Медиум</a>
					<a href="/classes/prisma" class="class-link-btn">Призма</a>
				</div>
			</div>

			<!-- Категория: Эксперты -->
			<div class="category-card">
				<h2 class="category-title">Эксперты</h2>
				<div class="classes-grid">
					<a href="/classes/alchemist" class="class-link-btn">Алхимик</a>
					<a href="/classes/engineer" class="class-link-btn">Инженер</a>
					<a href="/classes/bard" class="class-link-btn">Бард</a>
				</div>
			</div>

		</main>

	</body>
</html>