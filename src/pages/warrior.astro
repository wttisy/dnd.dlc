<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<title>Воин — Twilight Sparkles</title>
		<style>
			.glass-card {
				background: rgba(255, 255, 255, 0.15); 
				backdrop-filter: blur(10px);
				-webkit-backdrop-filter: blur(10px);
				border: 1px solid rgba(255, 255, 255, 0.2);
				border-radius: 20px;
				padding: 20px;
				color: #ffffff;
				text-decoration: none;
				font-weight: 600;
				font-size: 20px;
				transition: all 0.3s ease;
				display: block;
			}
			.glass-card:hover {
				background: rgba(255, 255, 255, 0.3);
				transform: scale(1.02);
			}
		</style>
	</head>
	<body style="
        font-family: sans-serif; 
        margin: 0; 
        min-height: 100vh; 
        background-image:  url('/bg.jpg'); 
        background-size: cover; 
		background-attachment: fixed;
        background-position: center; 
        background-repeat: no-repeat;
        display: flex; 
        flex-direction: column; 
        align-items: center; 
        padding: 60px 20px;
        color: #ffffff;
    ">
		
		<a href="/" style="position: absolute; left: 40px; top: 40px; color: #ffffff; text-decoration: none; font-weight: 600; opacity: 0.8; text-shadow: 0 2px 4px rgba(0,0,0,0.5);">← На главную</a>

		<h1 style="font-size: 38px; font-weight: 800; margin-bottom: 8px; text-shadow: 0 2px 5px rgba(0,0,0,0.5);">Тип: Воин</h1>
		<p style="font-size: 18px; color: #e2e8f0; margin-bottom: 40px; text-shadow: 0 2px 4px rgba(0,0,0,0.5);">Выберите класс для изучения:</p>
		
		<div style="display: flex; flex-direction: column; gap: 15px; width: 100%; max-width: 400px; padding: 0 20px;">
			<a href="/classes/zhnec" class="glass-card">Жнец</a>
			<a href="/classes/speedster" class="glass-card">Спидстер</a>
			<a href="/classes/assassin" class="glass-card">Ассасин</a>
			<a href="/classes/knight" class="glass-card">Рыцарь</a>
			<a href="/classes/oplot" class="glass-card">Оплот</a>
			<a href="/classes/jeger" class="glass-card">Егерь</a>
			<a href="/classes/paladin" class="glass-card">Паладин</a>
		</div>

	</body>
</html>